[run]
# branch = true
relative_files = true

source_pkgs =
    autotrainer.core
    autotrainer.device
    autotrainer.behavior
    autotrainer.inference
    # autotrainer.model
    # autotrainer.pyside
    autotrainer.video
    tools.acquisition
    # tools for the main acquisition app_model mainly

omit =
	# not yet sure where these are coming, but coverage get a ref. to these, which are non-existent here:
    config-3.py
    config.py
    shibokensupport/*
    signature_bootstrap.py
    */tests/*
    */auto-trainer-api/*

# allow coverage in python sub-processes (subprocess):
# patch = subprocess  # only valid from coverage 7.10+ but one for py3.8 is stuck lower.
# patch =
#   execv
#   _exit
#   fork
#   subprocess

# so using coverage-enable-subprocess for now.

parallel = true
# still needed

# Off on purpose. With sigterm = true coverage saves its data from a Python SIGTERM
# handler. In a child process that handler can deadlock on coverage's own data lock when
# the signal lands during a traced call (coveragepy issue 2310, fix PR 2317 open on
# 2026-11-05). Reproduced locally: multiprocessing's exit then joins that child forever and
# the process never exits. That this caused the CI hang (run 40435350385) is likely, not shown.
# Cost, measured on the CI suite: 21 more missed statements of 50927, in video_capture.py
# (17) and nidaq_stream_autostart.py (4), presumably code run in children that SIGTERM kills.
sigterm = false

[report]
show_missing = true
include_namespace_packages = true

omit =
    config-3.py
    config.py
    shibokensupport/*
    signature_bootstrap.py
    */tests/*
    */auto-trainer-api/*
