[Unit]
Description=Publish this computer's reachAQ animal metadata source
# Install this user unit on the single designated publisher computer only.
After=network-online.target
Wants=network-online.target
# The source, destination and mount guard come from `reachaq-animal-metadata setup`.
# A lab whose publication is on a network mount adds RequiresMountsFor= for it
# in a drop-in (systemctl --user edit reachaq-softmouse-publisher.service).

[Service]
Type=oneshot
# Support the Anaconda, Miniconda, and Mambaforge locations recognized by the
# portable installer. /usr/bin/env resolves conda using this explicit path.
Environment="PATH=%h/anaconda3/bin:%h/miniconda3/bin:%h/mambaforge/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env conda run --no-capture-output -n reachaq python -m reachaq.app.model.animal_sources.cli publish
WorkingDirectory=%h/Documents/reachAQ
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
