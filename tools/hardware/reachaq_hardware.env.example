# reachAQ hardware runtime environment.
# Copy the needed values into the shell or service environment on the Dell/Ubuntu machine.

# Preferred path for PCAN PCIe adapters exposed as Linux CAN network devices.
# The optional reachaq-can.service boot service brings the interfaces up; these
# AUTOTRAINER_* values tell the application which active interface to use.
# They are separate from the REACHAQ_CAN_* values read by systemd from
# /etc/default/reachaq-can. AUTOTRAINER_CAN_CHANNEL and
# REACHAQ_CAN_INTERFACE must select the same channel.
# Use "pcan_basic" only if you intentionally use python-can's PCAN backend instead.
AUTOTRAINER_HARDWARE_VERSION=alogus
AUTOTRAINER_CAN_TRANSPORT=socketcan
AUTOTRAINER_CAN_CHANNEL=can0
AUTOTRAINER_CAN_BITRATE=1000000
AUTOTRAINER_CAN_DATA_BITRATE=5000000
AUTOTRAINER_CAN_FD=true
AUTOTRAINER_CAN_RECEIVE_TIMEOUT_SECONDS=0.0

# Alternative PCAN Basic example:
# AUTOTRAINER_CAN_TRANSPORT=pcan_basic
# AUTOTRAINER_CAN_CHANNEL=PCAN_USBBUS1
# AUTOTRAINER_CAN_BITRATE=1000000
