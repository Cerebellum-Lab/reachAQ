[Unit]
Description=Publish a complete SoftMouse animal export for reachAQ
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/christielab10/anaconda3/envs/reachaq/bin/python -m tools.softmouse_sync.cli --config %h/.config/reachaq/softmouse-publisher.json
WorkingDirectory=/home/christielab10/Documents/reachAQ
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
