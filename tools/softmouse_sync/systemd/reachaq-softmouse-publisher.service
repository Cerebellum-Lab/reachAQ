[Unit]
Description=Publish a complete SoftMouse animal export for reachAQ
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python -m tools.softmouse_sync.cli --config %h/.config/reachaq/softmouse-publisher.json --username REPLACE_USERNAME
WorkingDirectory=/home/christielab10/Documents/reachAQ-sm-rfid
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
